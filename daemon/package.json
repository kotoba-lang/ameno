{
  "name": "@etzhayyim/ameno-daemon",
  "version": "0.1.0",
  "description": "Ameno headless system-resident daemon. Tier-2 worker host running the same LangGraph (reflection + active inference + ReAct tools) as the browser appview, but server-side via Ollama. ADR-2605191229.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "bin": {
    "ameno-daemon": "./src/server.ts"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "start:node": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@langchain/core": "^1.1.47",
    "@langchain/langgraph": "^1.3.1",
    "@langchain/langgraph-checkpoint": "^1.0.2",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@scure/base": "^2.2.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/etzhayyim/root.git",
    "directory": "60-apps/etzhayyim-project-ameno/daemon"
  }
}
